# Neon Postgres connection string (get this from your Neon dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Port the API listens on (Render sets this automatically in production)
PORT=4000

# Comma-separated list of allowed frontend origins (your Vercel URL, localhost for dev)
CORS_ORIGIN="http://localhost:3000,https://your-frontend.vercel.app"
